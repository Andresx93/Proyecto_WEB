.app-container {
  font-family: 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #e2e8f0;
  background-color: #0f172a; /* Deep Space Black */
  margin: 0;
  padding: 0;
  transition: all 0.3s ease;
}

/* Accessibility Bar */
.accessibility-bar {
  background: #1e293b;
  padding: 10px;
  display: flex;
  justify-content: center;
  gap: 10px;
  border-bottom: 1px solid #334155;
}

.acc-btn {
  padding: 5px 12px;
  cursor: pointer;
  border: 1px solid #475569;
  background: #1e293b;
  color: #cbd5e1;
  border-radius: 6px;
  font-size: 0.8rem;
  transition: all 0.2s;
}

.acc-btn:hover {
  background: #334155;
  color: white;
}

/* Header & Nav */
header {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: white;
  padding: 3rem 2rem;
  text-align: center;
  border-bottom: 1px solid #334155;
}

.nav-links {
  display: flex;
  justify-content: center;
  gap: 25px;
  margin-bottom: 2rem;
}

.nav-links a {
  color: #94a3b8;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  transition: color 0.3s;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.nav-links a:hover {
  color: #10b981; /* Emerald Neon */
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  margin-bottom: 1rem;
}

.main-logo {
  width: 100px;
  height: auto;
  filter: drop-shadow(0 0 15px rgba(16, 185, 129, 0.3));
}

header h1 {
  font-size: 2.5rem;
  margin: 0;
  background: linear-gradient(to right, #10b981, #34d399);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 800;
}

header p {
  color: #94a3b8;
  font-style: italic;
  font-weight: 300;
}

/* Slide Section */
.slide-container {
  width: 100%;
  height: 300px;
  background: linear-gradient(45deg, #0f172a, #1e293b);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1px solid #334155;
}

.slide-content {
  text-align: center;
  color: #10b981;
  font-size: 1.8rem;
  font-weight: 600;
  letter-spacing: -1px;
  animation: glow 3s infinite alternate;
}

@keyframes glow {
  from { text-shadow: 0 0 5px rgba(16,185,129,0.2); }
  to { text-shadow: 0 0 20px rgba(16,185,129,0.6); }
}

/* Accordion */
.accordion {
  max-width: 800px;
  margin: 3rem auto;
  padding: 0 1rem;
}

.accordion-item {
  background: #1e293b;
  border: 1px solid #334155;
  margin-bottom: 15px;
  border-radius: 12px;
  overflow: hidden;
  transition: border-color 0.3s;
}

.accordion-item:hover {
  border-color: #10b981;
}

.accordion-header {
  padding: 1.2rem;
  background: #1e293b;
  color: #f1f5f9;
  cursor: pointer;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  transition: background 0.3s;
}

.accordion-header:hover {
  background: #334155;
}

.accordion-body {
  padding: 1.2rem;
  display: none;
  border-top: 1px solid #334155;
  color: #94a3b8;
  line-height: 1.6;
}

.accordion-body.active {
  display: block;
}

/* Plans Section */
.plans-section {
  padding: 4rem 2rem;
  text-align: center;
}

.plans-section h2 {
  font-size: 2rem;
  margin-bottom: 2rem;
  color: white;
}

.ai-recommend-btn {
  background: linear-gradient(45deg, #10b981, #34d399);
  color: #0f172a;
  border: none;
  padding: 12px 24px;
  border-radius: 50px;
  cursor: pointer;
  font-weight: bold;
  margin-bottom: 3rem;
  transition: transform 0.2s, box-shadow 0.3s;
  box-shadow: 0 4px 15px rgba(16,185,129,0.3);
}

.ai-recommend-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(16,185,129,0.5);
}

.plans-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 30px;
  max-width: 1100px;
  margin: 0 auto;
}

.plan-card {
  background: rgba(30, 41, 59, 0.7);
  backdrop-filter: blur(10px);
  padding: 2.5rem;
  border-radius: 20px;
  border: 1px solid #334155;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.plan-card:hover {
  transform: translateY(-10px);
  border-color: #10b981;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

.plan-card h3 {
  color: white;
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

.plan-card p {
  color: #94a3b8;
  font-size: 0.95rem;
  margin-bottom: 1.5rem;
}

.plan-price {
  font-size: 2.2rem;
  font-weight: 800;
  color: white;
  margin: 1.5rem 0;
}

.plan-price span {
  font-size: 1rem;
  color: #94a3b8;
  font-weight: 400;
}

.btn-add-cart {
  background: #10b981;
  color: #0f172a;
  border: none;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  transition: background 0.3s;
}

.btn-add-cart:hover {
  background: #34d399;
}

/* Cart Section */
.cart-section {
  max-width: 600px;
  margin: 3rem auto;
  padding: 2rem;
  background: #1e293b;
  border-radius: 20px;
  border: 1px solid #334155;
  color: white;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0;
  border-bottom: 1px solid #334155;
}

.btn-checkout {
  width: 100%;
  background: linear-gradient(to right, #10b981, #059669);
  color: white;
  border: none;
  padding: 15px;
  margin-top: 1.5rem;
  border-radius: 10px;
  font-size: 1.1rem;
  font-weight: bold;
  cursor: pointer;
  transition: opacity 0.3s;
}

.btn-checkout:hover {
  opacity: 0.9;
}

/* Cloud Drive Section */
.cloud-section {
  padding: 4rem 2rem;
  background: rgba(30, 41, 59, 0.5);
  margin: 3rem 2rem;
  border-radius: 24px;
  border: 1px solid #334155;
}

.cloud-section h2 {
  color: white;
  margin-bottom: 2rem;
}

.upload-section {
  text-align: center;
  margin-bottom: 3rem;
}

.upload-btn {
  background: #10b981;
  color: #0f172a;
  padding: 15px 40px;
  border-radius: 50px;
  cursor: pointer;
  font-weight: bold;
  transition: all 0.3s;
  display: inline-block;
  box-shadow: 0 4px 15px rgba(16,185,129,0.3);
}

.upload-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(16,185,129,0.5);
}

.files-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin-top: 1rem;
  color: #cbd5e1;
}

.files-table th, .files-table td {
  padding: 15px;
  border-bottom: 1px solid #334155;
  text-align: left;
}

.files-table th {
  background-color: #1e293b;
  color: #94a3b8;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.8rem;
}

.btn-download {
  background: #334155;
  color: white;
  border: 1px solid #475569;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
  margin-right: 8px;
  transition: all 0.2s;
}

.btn-download:hover {
  background: #475569;
}

.btn-delete {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border: 1px solid #ef4444;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-delete:hover {
  background: #ef4444;
  color: white;
}

/* Contact & PQR */
.contact-section {
  padding: 4rem 2rem;
  background: #0f172a;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  max-width: 1200px;
  margin: 4rem auto;
}

.pqr-form {
  display: flex;
  flex-direction: column;
  gap: 15px;
  background: #1e293b;
  padding: 2.5rem;
  border-radius: 20px;
  border: 1px solid #334155;
  color: white;
}

.pqr-form h2 {
  margin-bottom: 1rem;
  color: #10b981;
}

.pqr-form label {
  font-size: 0.9rem;
  color: #94a3b8;
}

.pqr-form input, .pqr-form textarea {
  padding: 12px;
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 8px;
  color: white;
  font-family: inherit;
  outline: none;
  transition: border-color 0.3s;
}

.pqr-form input:focus, .pqr-form textarea:focus {
  border-color: #10b981;
}

.btn-submit-pqr {
  background: #10b981;
  color: #0f172a;
  border: none;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  transition: all 0.3s;
}

.btn-submit-pqr:hover {
  background: #34d399;
}

.map-container {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.map-container h2 {
  color: white;
  text-align: center;
}

.map-container iframe {
  width: 100%;
  height: 100%;
  border-radius: 20px;
  min-height: 300px;
  filter: grayscale(0.2) invert(0.9) hue-rotate(180deg); /* Estilo nocturno para el mapa */
  border: 1px solid #334155;
}

/* Devs Section */
.devs-section {
  padding: 4rem 2rem;
  text-align: center;
  background: #0f172a;
}

.devs-section h2 {
  color: white;
  margin-bottom: 3rem;
}

.devs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 30px;
  max-width: 1100px;
  margin: 0 auto;
}

.dev-card {
  background: #1e293b;
  padding: 2rem;
  border-radius: 20px;
  border: 1px solid #334155;
  transition: all 0.3s ease;
  color: white;
}

.dev-card:hover {
  transform: translateY(-10px);
  border-color: #10b981;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.dev-photo {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 1rem;
  border: 3px solid #10b981;
  box-shadow: 0 0 10px rgba(16,185,129,0.3);
}

.dev-name {
  font-weight: 700;
  font-size: 1.2rem;
  margin-bottom: 5px;
}

.dev-role {
  color: #94a3b8;
  font-size: 0.9rem;
  margin-bottom: 15px;
}

.dev-phone {
  color: #10b981;
  font-weight: 600;
  font-size: 0.9rem;
}

/* Footer */
footer {
  background: #0f172a;
  color: white;
  padding: 4rem 2rem;
  text-align: center;
  border-top: 1px solid #334155;
}

.social-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 2rem;
}

.social-links a {
  color: #94a3b8;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
  background: #1e293b;
  padding: 10px 20px;
  border-radius: 50px;
  border: 1px solid #334155;
  transition: all 0.3s;
}

.social-links a:hover {
  background: #10b981;
  color: #0f172a;
  border-color: #10b981;
}

.privacy-text {
  font-size: 0.8rem;
  color: #64748b;
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
}
